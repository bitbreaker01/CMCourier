@echo off
setlocal EnableDelayedExpansion

rem CMCourier @@PROJECT_VERSION@@ offline installer
rem Generated from installer/templates/install.bat.tmpl by build-offline-bundle.ps1
rem Target: Python @@PYTHON_VERSION@@ on Windows x86_64 (64-bit)

rem Launched by double-click (cmd /c "...install.bat")? Then pause before the
rem window closes so the operator can read the error.
set "PAUSE_ON_EXIT="
echo %cmdcmdline% | find /i "%~f0" >nul 2>&1 && set "PAUSE_ON_EXIT=1"

set "TARGET_VERSION=@@PYTHON_VERSION@@"

rem ---------------------------------------------------------------------
rem [1/6] Resolve the Python interpreter (BEFORE cd, so a relative PYTHON
rem       is taken from the operator's directory, not the bundle's)
rem   1. %PYTHON% if defined (quotes stripped, path made absolute).
rem   2. py -@@PYTHON_VERSION@@ (python.org launcher) if it works.
rem   3. python.
rem PY is the executable (always invoked quoted: the path may contain
rem spaces), PYARGS the launcher arguments (only for "py -X.Y").
rem ---------------------------------------------------------------------
echo === CMCourier @@PROJECT_VERSION@@ offline installer ===
echo [1/6] Resolving Python interpreter...
set "PYARGS="
if defined PYTHON (
    set "PY=!PYTHON:"=!"
    if not "!PY:\=!"=="!PY!" for %%p in ("!PY!") do set "PY=%%~fp"
    echo       PYTHON is set, using: !PY!
) else (
    py -@@PYTHON_VERSION@@ -c "import sys" >nul 2>&1
    if not errorlevel 1 (
        set "PY=py"
        set "PYARGS=-@@PYTHON_VERSION@@"
        echo       Found py launcher for @@PYTHON_VERSION@@: py -@@PYTHON_VERSION@@
    ) else (
        where python >nul 2>nul
        if errorlevel 1 (
            echo ERROR: no Python interpreter found in PATH.
            echo        Install Python @@PYTHON_VERSION@@ x86_64 from python.org first ^(not the Microsoft Store^).
            goto :fail
        )
        set "PY=python"
        echo       Using generic "python" from PATH.
    )
)

set "INSTALL_DIR=%~dp0"
cd /d "%INSTALL_DIR%" || goto :fail
echo Install dir: %INSTALL_DIR%
echo Target Python: %TARGET_VERSION% ^(64-bit^)
echo.

rem ---------------------------------------------------------------------
rem [2/6] Check major.minor AND 64-bit BEFORE creating .venv
rem ---------------------------------------------------------------------
echo [2/6] Checking the version of !PY! !PYARGS!...
call :probe "!PY!" "!PYARGS!"
if not defined FOUND_VERSION (
    echo ERROR: could not run "!PY!" !PYARGS! to check its version.
    echo        If PYTHON points to a path, check that it exists ^(no quotes needed^).
    goto :fail
)
if not "!FOUND_VERSION!"=="!TARGET_VERSION!" (
    echo ERROR: !PY! !PYARGS! is Python !FOUND_VERSION!, expected Python !TARGET_VERSION!.
    echo        Found:    !FOUND_VERSION!
    echo        Expected: !TARGET_VERSION!
    echo        Point to the correct interpreter with:
    echo          set PYTHON=C:\Python@@PYTHON_VERSION_NODOT@@\python.exe
    echo          install.bat
    goto :fail
)
if not "!FOUND_BITS!"=="64" (
    echo ERROR: !PY! !PYARGS! is a !FOUND_BITS!-bit Python; this bundle needs 64-bit ^(win_amd64^).
    echo        Install Python !TARGET_VERSION! x86_64 ^(64-bit^) from python.org, or point
    echo        PYTHON at it:
    echo          set PYTHON=C:\Python@@PYTHON_VERSION_NODOT@@\python.exe
    goto :fail
)
echo       OK: !PY! !PYARGS! is Python !FOUND_VERSION! ^(64-bit^).

if exist .venv (
    if not exist .venv\Scripts\python.exe (
        echo ERROR: .venv exists but has no Scripts\python.exe ^(incomplete or foreign venv^).
        echo        Delete it and re-run:
        echo          rmdir /s /q .venv
        echo          install.bat
        goto :fail
    )
    call :probe ".venv\Scripts\python.exe" ""
    if not "!FOUND_VERSION!"=="!TARGET_VERSION!" (
        echo ERROR: existing .venv is Python !FOUND_VERSION!, expected Python !TARGET_VERSION!.
        echo        Delete it and re-run:
        echo          rmdir /s /q .venv
        echo          install.bat
        goto :fail
    )
    echo       OK: existing .venv is Python !FOUND_VERSION!.
)

rem ---------------------------------------------------------------------
rem [3/6] Create the virtualenv (if it doesn't exist)
rem ---------------------------------------------------------------------
echo [3/6] Creating virtualenv (.venv)...
if exist .venv (
    echo       .venv already exists, reusing.
) else (
    "!PY!" !PYARGS! -m venv .venv
    if errorlevel 1 (
        echo ERROR: Failed to create .venv.
        goto :fail
    )
    if not exist .venv\Scripts\python.exe (
        echo ERROR: .venv was created without Scripts\python.exe.
        echo        Delete it ^(rmdir /s /q .venv^) and check the Python installation.
        goto :fail
    )
)

rem ---------------------------------------------------------------------
rem [4/6] Upgrade pip from the local wheelhouse, if the bundle has it
rem ---------------------------------------------------------------------
echo [4/6] Upgrading pip from local wheelhouse (if available)...
if exist wheels\pip-*.whl (
    ".venv\Scripts\python.exe" -m pip install --no-index --find-links wheels --upgrade pip setuptools wheel
    if errorlevel 1 (
        echo ERROR: pip upgrade failed.
        goto :fail
    )
) else (
    echo       No pip wheel in wheels\, skipping upgrade.
)

rem ---------------------------------------------------------------------
rem [5/6] Install cmcourier offline
rem ---------------------------------------------------------------------
echo [5/6] Installing cmcourier and dependencies (offline)...
".venv\Scripts\python.exe" -m pip install --no-index --find-links wheels cmcourier
if errorlevel 1 (
    echo ERROR: cmcourier install failed.
    goto :fail
)

rem ---------------------------------------------------------------------
rem [6/6] Verify
rem ---------------------------------------------------------------------
echo [6/6] Verifying...
".venv\Scripts\cmcourier.exe" --version
if errorlevel 1 (
    echo ERROR: cmcourier failed to run.
    goto :fail
)

echo.
echo === Installed successfully ===
echo.
echo Next steps:
echo   1. Install IBM i Access ODBC driver if not present (AS400/RVI source).
echo   2. Install Microsoft ODBC Driver 18 for SQL Server if there is an MSSQL source.
echo   3. Configure a System DSN (64-bit) for each ODBC source that uses one.
echo   4. Edit config\config-prod.yaml (copy from .template).
echo   5. Run:  .venv\Scripts\cmcourier.exe --config config\config-prod.yaml [command]
echo.
if defined PAUSE_ON_EXIT pause
endlocal
exit /b 0

rem ---------------------------------------------------------------------
rem :probe <exe> <args>  ->  FOUND_VERSION (X.Y) and FOUND_BITS (32/64)
rem   A plain command line redirected to a temp file: no `for /f` over a
rem   command (there `cmd /c` re-parses the quotes and swallows `2>nul`),
rem   and no "%" in the probe so cmd has nothing to re-expand.
rem ---------------------------------------------------------------------
:probe
set "FOUND_VERSION="
set "FOUND_BITS="
"%~1" %~2 -c "import sys, struct; print('.'.join(map(str, sys.version_info[:2])), struct.calcsize('P')*8)" > "%TEMP%\cmcourier-pyver.txt" 2>nul
for /f "usebackq tokens=1,2" %%a in ("%TEMP%\cmcourier-pyver.txt") do (
    set "FOUND_VERSION=%%a"
    set "FOUND_BITS=%%b"
)
del "%TEMP%\cmcourier-pyver.txt" >nul 2>&1
exit /b 0

:fail
if defined PAUSE_ON_EXIT pause
endlocal
exit /b 1
