# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
wheels/
pip-wheel-metadata/
share/python-wheels/

# Virtual environments
.venv/
venv/
env/
ENV/

# Tooling caches
.ruff_cache/
.mypy_cache/
.pytest_cache/
.tox/
.nox/

# Coverage
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/

# Type-check artifacts
.dmypy.json
dmypy.json

# Pre-commit
.pre-commit/

# Operational artifacts (created at runtime by CMCourier)
logs/
tmp/
# Internal docs workspace (dossier + scratch for doc agents)
docs/_internal/
# /staging anchored to root — scripts/staging/ scaffolding stays tracked (039)
/staging/
# dev-box compose override + keystore generated by generate-keystore.sh
scripts/staging/alfresco-compose.local.yml
scripts/staging/alfresco-extension/
# /sample synthetic dry-run data (rvabrep CSVs, materialized files, tracking DBs) — never commit
/sample/
data/migration_tracking.db
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS junk
.DS_Store
Thumbs.db

# Local secrets — credentials live in env vars per Constitution Principle V/VIII
.env
.env.local
*.local

# pyenv
.python-version

# Generated XLSX test fixtures (deterministic regeneration via tests/conftest.py)
tests/fixtures/sources/*.xlsx

# Generated assembly test fixtures (regenerated by tests/integration/adapters/conftest.py)
tests/fixtures/assembly/**/*.pdf
tests/fixtures/assembly/**/*.PDF
tests/fixtures/assembly/**/*.tif
tests/fixtures/assembly/**/*.tiff
tests/fixtures/assembly/**/*.TIF
tests/fixtures/assembly/**/*.TIFF
tests/fixtures/assembly/**/*.jpg
tests/fixtures/assembly/**/*.jpeg
tests/fixtures/assembly/**/*.JPG
tests/fixtures/assembly/**/*.JPEG
# Numeric-extension page files (.001, .002, ..., .10, .540, etc.)
tests/fixtures/assembly/**/*.[0-9]
tests/fixtures/assembly/**/*.[0-9][0-9]
tests/fixtures/assembly/**/*.[0-9][0-9][0-9]
tests/fixtures/assembly/**/*.[0-9][0-9][0-9][0-9]

# Output del instalador offline (installer/build-offline-bundle.{ps1,sh}):
# wheels descargados — grande, binario, NO se commitea.
dist-offline/

# Bundles de export / release (scripts/export-bundle.sh → releases/).
# NO se commitean — son binarios; se publican en GitHub Releases vía
# scripts/publish-release.sh.
releases/
